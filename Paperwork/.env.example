# Copy this file to .env and replace the Entra values with your app registration.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=true
PUBLIC_BASE_URL=https://info.pdf.infoorigin.com
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret
# Comma-separated Entra email/username values to bootstrap as organization owners.
INITIAL_ADMIN_EMAILS=admin@yourcompany.com
# One local administrator account; set a password of at least 12 characters in .env.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_EMAIL=admin@yourcompany.com
LOCAL_ADMIN_PASSWORD=
STORAGE_ENCRYPTION_KEY=generate-a-fernet-key-and-keep-it-secret
MAX_STORAGE_BYTES_PER_USER=1073741824
MAX_UPLOAD_BYTES=52428800
MAX_TOTAL_UPLOAD_BYTES=104857600
MAX_PDF_PAGES=500
